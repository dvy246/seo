---
import '@/styles/globals.css'

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'MetaForge — Free SEO Audit & AI Readiness Checker with Meta Tag Generator',
  description = 'Audit any URL for AI search readiness (ChatGPT, Perplexity, Google AI Overviews). Get a 100-point score across SEO, social, structured data, and llms.txt. Then generate validated meta tags to fix what is missing. Free, no signup.',
  canonical,
  ogImage,
} = Astro.props;

const baseUrl = 'https://metaforge.app';
const canonicalUrl = canonical || new URL(Astro.url.pathname, baseUrl).toString();
const ogImageUrl = ogImage || `${baseUrl}/og-image.png`;

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'MetaForge',
  url: baseUrl,
  description: 'Free SEO audit tool with AI readiness scoring. Audit any URL for ChatGPT, Perplexity, and Google AI Overviews visibility. Checks llms.txt, JSON-LD structured data, meta tags, and social previews. Includes a validated meta tag generator.',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    'AI readiness audit with 100-point score',
    'Server-side URL fetching (bypasses CORS)',
    'llms.txt detection',
    'JSON-LD structured data validation',
    'SEO meta tag audit (title, description, canonical, H1)',
    'Open Graph and Twitter Card audit',
    'Accessibility checks (viewport, lang, alt text)',
    'Validated meta tag generator',
    'Google SERP preview',
    'Social card previews (Facebook, Twitter)',
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is an AI readiness audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'An AI readiness audit checks whether your website is optimized for AI search engines like ChatGPT, Perplexity, Google AI Overviews, and Claude. It verifies you have structured data (JSON-LD), an llms.txt file, indexable content, sufficient word count, and proper meta tags — the signals AI engines use to discover and cite your content.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is this different from a regular SEO audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Traditional SEO audits check Google ranking factors. MetaForge goes further: it audits for AI search engine visibility (GEO — Generative Engine Optimization). It checks for llms.txt, structured data that AI engines use to cite sources, content depth, and robots directives that affect AI crawlers like GPTBot and PerplexityBot. No other free tool does this.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is MetaForge free to use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Both the AI readiness auditor and the meta tag generator are completely free with no signup required. All processing happens in your browser — the audit fetches your URL server-side but stores no personal data.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is llms.txt and why does it matter?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'llms.txt is a new standard (like robots.txt but for AI) that tells AI crawlers what your site is about and which pages matter. It helps ChatGPT, Perplexity, and other AI engines discover and correctly cite your content. MetaForge is the first free tool to check for it.',
      },
    },
    {
      '@type': 'Question',
      name: 'What makes MetaForge different from other SEO tools?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'MetaForge is the only free tool that combines a URL auditor with AI readiness scoring and a validated meta tag generator. It checks your live site for AI search visibility — something no competitor offers for free. The server-side URL fetch bypasses browser CORS limits that block every client-only tool.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does the meta tag generator validate its output?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'MetaForge checks every generated tag against current SEO specifications in real time. It verifies title length (30-60 characters), description length (70-160 characters), Open Graph image requirements, Twitter Card requirements, JSON-LD schema validity, and flags deprecated tags like the keywords meta tag.',
      },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: baseUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'AI Readiness Audit',
      item: canonicalUrl,
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="MetaForge" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="MetaForge" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- AI Bot Access (GEO) -->
    <meta name="allowed-ai-bots" content="GPTBot, ChatGPT-User, PerplexityBot, ClaudeBot, anthropic-ai, Googlebot, Bingbot" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- Theme script to prevent FOUC -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('mf_theme');
        var isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased grain-overlay">
    <slot />
  </body>
</html>
