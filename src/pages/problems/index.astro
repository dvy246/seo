---
import Layout from '@/layouts/Layout.astro';
import { ProblemGuide } from '@/components/ProblemGuide';
import { problemGuides } from '@/data/problems';

const pageMeta = {
  '/problems': {
    title: 'SEO Problems Explained — Fix Common Meta, OG & Indexing Issues | SerpCraft',
    description:
      'Evidence-based walkthroughs for the most common SEO and social-sharing problems: Google rewriting your description, OG images not showing, canonical/noindex conflicts, schema not triggering rich results, and crawlers seeing different HTML.',
    keywords: 'seo problems, meta description not showing, og image not showing, canonical noindex conflict, schema not showing, google sees different html',
  },
};
---

<Layout path="/problems" title={pageMeta['/problems'].title} description={pageMeta['/problems'].description} keywords={pageMeta['/problems'].keywords} noHreflang>
  <div className="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <div className="text-center mb-10">
      <h1 className="font-serif text-3xl sm:text-4xl font-semibold text-ink dark:text-sand-50 mb-3">
        SEO Problems, Diagnosed with Evidence
      </h1>
      <p className="text-sm sm:text-base text-ink-muted dark:text-sand-400 max-w-2xl mx-auto">
        The five most common "why is my site doing that" questions — each with the real causes, a step-by-step diagnosis you can run yourself, and the exact fix. No speculation, no fluff.
      </p>
    </div>

    <div className="grid gap-4 sm:grid-cols-2">
      {problemGuides.map((guide) => (
        <a
          key={guide.slug}
          href={guide.path}
          className="card p-5 hover:border-choco-400 dark:hover:border-choco-600 transition-colors block group"
        >
          <h2 className="text-base font-semibold text-ink dark:text-sand-50 group-hover:text-choco-600 dark:group-hover:text-choco-400 transition-colors mb-1.5">
            {guide.h1}
          </h2>
          <p className="text-sm text-ink-soft dark:text-sand-300 leading-relaxed line-clamp-3">{guide.symptom}</p>
        </a>
      ))}
    </div>

    <div className="card p-6 text-center mt-10">
      <h2 className="text-lg font-semibold text-ink dark:text-sand-50 mb-1">Have a different problem?</h2>
      <p className="text-sm text-ink-soft dark:text-sand-300 mb-4">
        Paste your URL into the URL Debugger — the report itself usually names the issue.
      </p>
      <a href="/url-debugger" className="btn btn-primary">Debug a URL free</a>
    </div>
  </div>
</Layout>
